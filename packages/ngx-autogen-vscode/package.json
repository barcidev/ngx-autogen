{
  "name": "ngx-autogen",
  "displayName": "Angular Autogen",
  "description": "Generate NgRx Signal Store, Transloco i18n scopes and Angular components from the context menu",
  "publisher": "barcidev",
  "author": "Jorge Palacio",
  "license": "MIT",
  "icon": "logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jpalacio09/ngx-autogen.git"
  },
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "angular",
    "ngrx",
    "signals",
    "transloco",
    "i18n",
    "schematics",
    "autogen"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ngx-autogen.generateComponent",
        "title": "ngx-autogen: Generate Component"
      },
      {
        "command": "ngx-autogen.generateStore",
        "title": "ngx-autogen: Generate Store"
      },
      {
        "command": "ngx-autogen.generateI18n",
        "title": "ngx-autogen: Generate i18n Scope"
      },
      {
        "command": "ngx-autogen.generateComponentInteractive",
        "title": "ngx-autogen: Generate Custom Component"
      },
      {
        "command": "ngx-autogen.generateStoreInteractive",
        "title": "ngx-autogen: Generate Custom Store"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "ngx-autogen.submenu",
          "group": "navigation",
          "when": "explorerResourceIsFolder"
        }
      ],
      "ngx-autogen.submenu": [
        {
          "command": "ngx-autogen.generateComponent",
          "group": "1_generate@1"
        },
        {
          "command": "ngx-autogen.generateStore",
          "group": "1_generate@2"
        },
        {
          "command": "ngx-autogen.generateI18n",
          "group": "1_generate@3"
        },
        {
          "command": "ngx-autogen.generateComponentInteractive",
          "group": "2_interactive@1",
          "when": "ngx-autogen:hasConfig"
        },
        {
          "command": "ngx-autogen.generateStoreInteractive",
          "group": "2_interactive@2",
          "when": "ngx-autogen:hasConfig"
        }
      ]
    },
    "submenus": [
      {
        "id": "ngx-autogen.submenu",
        "label": "Ngx Autogen"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.1.3"
  }
}
