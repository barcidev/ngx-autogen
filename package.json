{
  "name": "@barcidev/ngx-autogen",
  "version": "0.1.71",
  "description": "A collection of Angular schematics for essential functionalities.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.lib.json",
    "release": "npm run build && npm publish --access public",
    "test": "npm run build && jasmine src/**/*_spec.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "src/**/*.js",
    "src/**/*.template",
    "src/**/*.d.ts",
    "src/**/schema.json",
    "src/collection.json",
    "dist/lib/**/*.js",
    "dist/lib/**/*.d.ts",
    "README.md",
    "README_ES.md",
    "LICENSE"
  ],
  "keywords": [
    "angular",
    "schematics",
    "state-management",
    "ngrx",
    "signals",
    "scaffolding"
  ],
  "author": "Jorge Palacio Barcinilla",
  "license": "MIT",
  "schematics": "./src/collection.json",
  "repository": {
    "type": "git",
    "url": "https://github.com/jpalacio09/ngx-autogen.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/jpalacio09/ngx-autogen#readme",
  "bugs": {
    "url": "https://github.com/jpalacio09/ngx-autogen/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/jpalacio09"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@angular-devkit/core": "^21.2.0",
    "@angular-devkit/schematics": "^21.2.0",
    "@barcidev/typed-transloco": "^0.0.15",
    "@schematics/angular": "^21.2.0",
    "ts-morph": "^28.0.0",
    "typescript": "~5.9.2"
  },
  "devDependencies": {
    "@angular-devkit/schematics-cli": "^21.2.0",
    "@angular/forms": "^21.2.11",
    "@ngrx/signals": "^21.1.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "copyfiles": "^2.4.1",
    "jasmine": "^5.0.0"
  },
  "peerDependencies": {
    "@angular/common": ">=17.0.0",
    "@angular/core": ">=17.0.0",
    "@angular/forms": ">=17.0.0",
    "@ngrx/signals": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/forms": {
      "optional": true
    },
    "@ngrx/signals": {
      "optional": true
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./entity": {
      "types": "./dist/lib/entity/index.d.ts",
      "default": "./dist/lib/entity/index.js"
    }
  }
}
